    "fc_spawn_control_plane.log.get": {
      "desc": "Default (`follow=false`, or omitted) returns the full log so far\nas `text/plain`, one raw line per row. Set `?follow=true` to\nstream `application/x-ndjson`; each newline-delimited line is a\n`TemplateLogLine` JSON object. The stream stays open, tailing new\nrows every 500 ms, until the template reaches a terminal status\nor the client disconnects. Empty for pending templates, partial\nwhile building.\n",
      "inputs": [
        {
          "id": {
            "LOCATION": "path",
            "REQUIRED": true,
            "TYPE": "STRING"
          }
        },
        {
          "follow": {
            "DEFAULT": false,
            "LOCATION": "query",
            "REQUIRED": false,
            "TYPE": "BOOL"
          }
        },
        {
          "attempt": {
            "LOCATION": "query",
            "MINIMUM": 1,
            "REQUIRED": false,
            "TYPE": "INT"
          }
        },
        {
          "limit": {
            "LOCATION": "query",
            "MINIMUM": 1,
            "REQUIRED": false,
            "TYPE": "INT"
          }
        }
      ],
      "integration": "CreateOS.sandbox@0.1.0",
      "method_hash": "25235072e4da3c16e497a8c3cb0c7856a5d0d858f54642401f14879c228158f4",
      "output": {
        "schema": {
          "type": "any"
        },
        "status": 200
      },
      "summary": "Fetch or stream build logs for a template",
      "type": "method"
    },
    "fc_spawn_control_plane.pause.create": {
      "desc": "Snapshots the sandbox to storage and frees its host. Disk +\nmemory + processes are all preserved exactly. Returns 202 with\nthe row in `pausing`; poll `GET /v1/sandboxes/{id}` until status\nflips to `paused`. Typical pause completes in ~3s for a 1 GiB\nsandbox.\n",
      "inputs": [
        {
          "id": {
            "LOCATION": "path",
            "REQUIRED": true,
            "TYPE": "STRING"
          }
        }
      ],
      "integration": "CreateOS.sandbox@0.1.0",
      "method_hash": "bdac64d3b3cf9b6e019b1133abb5f1eb23ef8b4ed0b72d42cf9c38fdaf722166",
      "output": {
        "schema": {
          "properties": {
            "data": {
              "properties": {
                "id": {
                  "required": false,
                  "type": "string"
                },
                "status": {
                  "required": false,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "status": {
              "required": true,
              "type": "string"
            }
          },
          "required": [
            "data",
            "status"
          ]
        },
        "status": 202
      },
      "summary": "Pause a running sandbox, preserving disk + memory state",
      "type": "method"
    },
    "fc_spawn_control_plane.resume.create": {
      "desc": "Brings a paused sandbox back to `running`. Disk + memory are\nrestored exactly; the sandbox gets a fresh IP. Returns 202 with\nthe row in `resuming`; poll until status flips to `running`.\nTypical resume completes in \u003c1s if the original host is still\navailable, ~10–13s when fetched from storage.\n\nRetries on a different host if the first attempt fails. If all\nattempts are exhausted the row goes to `error` — POST `/resume`\nagainst that row to try again with a fresh budget.\n",
      "inputs": [
        {
          "id": {
            "LOCATION": "path",
            "REQUIRED": true,
            "TYPE": "STRING"
          }
        }
      ],
      "integration": "CreateOS.sandbox@0.1.0",
      "method_hash": "e05e3c9186247b6cd9430a227ec6818a2717b3cbbf13f547911485c6346fcef4",
      "output": {
        "schema": {
          "properties": {
            "data": {
              "properties": {
                "id": {
                  "required": false,
                  "type": "string"
                },
                "status": {
                  "required": false,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "status": {
              "required": true,
              "type": "string"
            }
          },
          "required": [
            "data",
            "status"
          ]
        },
        "status": 202
      },
      "summary": "Restore a paused sandbox",
      "type": "method"
    },
