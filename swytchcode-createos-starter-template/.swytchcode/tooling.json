  "tools": {
    "fc_spawn_control_plane.exec.create": {
      "desc": "Two response modes selected by the `stream` query parameter\n(or the `stream` field in the request body):\n\n**Buffered (default).** Agent runs the cmd to completion and returns\na JSend envelope with `stdout`, `stderr`, and `exit_code`. Suitable\nfor short, well-behaved commands.\n\n**Streaming (`?stream=true`).** Agent emits one JSON object per\nline over `Content-Type: application/x-ndjson` (HTTP/1.1 chunked).\nEach line is an `ExecStreamEvent` with the same field names as\nthe buffered shape — so a single struct parses both worlds. The\nterminal frame carries `exit_code`. Heartbeat lines (`{\"hb\":true}`)\nare emitted every 5 seconds so a dead client is detected and the\nin-VM command killed within ~5s of disconnect.\n\nBackground processes must detach (redirect stdio + `\u0026`) or\nthe exec blocks until they exit.\n",
      "inputs": [
        {
          "id": {
            "LOCATION": "path",
            "REQUIRED": true,
            "TYPE": "STRING"
          }
        },
        {
          "stream": {
            "DEFAULT": false,
            "LOCATION": "query",
            "REQUIRED": false,
            "TYPE": "BOOL"
          }
        },
        {
          "body": {
            "CONTENT_TYPE": "application/json",
            "LOCATION": "body",
            "REQUIRED": true,
            "TYPE": "OBJECT",
            "schema": {
              "properties": {
                "args": {
                  "required": false,
                  "type": "[]STRING"
                },
                "cmd": {
                  "required": true,
                  "type": "string"
                },
                "env": {
                  "required": false,
                  "type": "map[STRING]STRING"
                },
                "stdin": {
                  "required": false,
                  "type": "string"
                },
                "stream": {
                  "required": false,
                  "type": "boolean"
                }
              },
              "required": [
                "cmd"
              ]
            }
          }
        }
      ],
      "integration": "CreateOS.sandbox@0.1.0",
      "method_hash": "bb7b6c67dcf45597a4eb26513cd4a8c1bea4c82890e243973cbf43435186829c",
      "output": {
        "schema": {
          "properties": {
            "data": {
              "properties": {
                "exec_ms": {
                  "required": false,
                  "type": "FLOAT"
                },
                "result": {
                  "properties": {
                    "exit_code": {
                      "required": false,
                      "type": "integer"
                    },
                    "stderr": {
                      "required": false,
                      "type": "string"
                    },
                    "stdout": {
                      "required": false,
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "status": {
              "required": true,
              "type": "string"
            }
          },
          "required": [
            "data",
            "status"
          ]
        },
        "status": 200
      },
      "summary": "Run a command inside the sandbox (buffered or streaming)",
      "type": "method"
    },
