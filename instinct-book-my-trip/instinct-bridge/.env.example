# setup.sh writes .env for you. Everything here is optional.

# Where approvals go, as set for the workspace in the Swytchcode app: Slack or Telegram
APPROVAL_APP=Slack

# Times in the sheet use this zone (setup.sh copies this machine's)
TZ=UTC

# Confirmation emails. With Resend's test sender, mail only reaches your own Resend address.
EMAIL_FROM=Book My Trip <onboarding@resend.dev>

POLL_SECONDS=2
WAITING_CHECK_SECONDS=10
APPROVAL_WAIT_SECONDS=720
